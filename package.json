{
  "name": "pi-claude",
  "version": "1.7.3",
  "private": false,
  "type": "module",
  "description": "Adds a Claude Pro/Max Native provider to Pi with mode-aware Claude Code and Agent SDK wire profiles, OAuth, live model discovery, and captured request signals.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "anthropic",
    "claude",
    "claude-code",
    "oauth",
    "subscription",
    "claude-pro",
    "claude-max"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "VERIFY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "capture:fingerprint": "node --import tsx scripts/capture-fingerprint.mjs",
    "classifier:find": "node --import tsx scripts/bisect-classifier.ts auto"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.5",
    "@earendil-works/pi-coding-agent": ">=0.80.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
